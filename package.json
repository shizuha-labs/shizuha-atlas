{
  "name": "@shizuha/atlas",
  "version": "0.1.0",
  "description": "A reusable semantic architecture explorer with expandable maps and host-provided diagram lenses.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./styles.css": "./dist/atlas.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext tests/types.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "node scripts/pack.mjs",
    "verify": "npm test && npm run typecheck && npm run pack:check",
    "publish:internal": "node scripts/publish.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-router-dom": "^7.18.0"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "lucide-react": "0.303.0"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "typescript": "5.9.3"
  },
  "engines": {"node": ">=20"},
  "license": "MIT",
  "keywords": ["architecture", "diagram", "react", "semantic-zoom", "documentation"]
}

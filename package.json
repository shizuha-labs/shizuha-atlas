{
  "name": "@shizuha/atlas",
  "version": "0.3.1",
  "description": "A portable visual system-design editor and semantic architecture explorer for people and agents.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.mjs"
    },
    "./styles.css": "./dist/atlas.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/atlas-cli.mjs",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.json"
  ],
  "bin": {
    "atlas": "scripts/atlas-cli.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext tests/types.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "node scripts/pack.mjs",
    "verify": "npm test && npm run typecheck && npm run pack:check",
    "publish:internal": "node scripts/publish.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-router-dom": "^7.18.0"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "lucide-react": "0.303.0"
  },
  "devDependencies": {
    "mermaid": "12.0.0",
    "@types/react": "18.3.28",
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "keywords": [
    "architecture",
    "diagram",
    "react",
    "semantic-zoom",
    "documentation"
  ]
}
